{
    "name": "studapart/stud-cli",
    "description": "Stud Cli DX - Jira & Git Workflow Streamliner",
    "type": "project",
    "license": "MIT",
    "version": "4.1.0",
    "authors": [
        {
            "name": "Pierre-Emmanuel Manteau",
            "homepage": "https://github.com/PEM-FR",
            "role": "Head of Engineering"
        }
    ],
    "support": {
        "issues": "https://github.com/studapart/stud-cli/issues",
        "source": "https://github.com/studapart/stud-cli"
    },
    "homepage": "https://github.com/studapart/stud-cli",
    "keywords": [
        "stud",
        "stud-cli",
        "jira",
        "git",
        "workflow"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Studapart/adf-tools.git"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "ext-xml": "*",
        "symfony/http-client": "^8.1",
        "symfony/process": "^8.1",
        "symfony/console": "^8.1",
        "symfony/string": "^8.1",
        "jolicode/castor": "1.8.1",
        "symfony/yaml": "^8.1",
        "symfony/translation": "^8.1",
        "stevebauman/hypertext": "^1.1",
        "league/html-to-markdown": "^5.0",
        "league/flysystem": "^3.0",
        "league/flysystem-local": "^3.0",
        "studapart/adf-tools": "^1.2.2",
        "league/commonmark": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "minimum-stability": "dev",
        "prefer-stable": true,
        "allow-plugins": {
            "symfony/flex": true
        },
        "platform": {
            "php": "8.4.1"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpspec/prophecy-phpunit": "^2.4",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "league/flysystem-memory": "^3.31"
    },
    "scripts": {
        "dump-config": "php scripts/dump-config.php"
    }
}